<file path="app/src/commonTest/kotlin/com/revlens/app/data/fake/FakeAuthRepository.kt">
package com.revlens.app.data.fake

import com.revlens.app.core.platform.SecureStorage
import com.revlens.app.core.ui.AppError
import com.revlens.app.core.ui.AppException
import com.revlens.app.domain.model.UserAccount
import com.revlens.app.domain.repository.AuthRepository

class FakeAuthRepository(
    private val secureStorage: SecureStorage? = null,
    initialUser: UserAccount? = null
) : AuthRepository {

    private var currentUser: UserAccount? = initialUser

    override suspend fun loginWithGoogle(
        idToken: String?,
        email: String?,
        name: String?,
        avatarUrl: String?
    ): Result<UserAccount> {
        val userEmail = email?.trim()?.lowercase() ?: "alex.vance@gmail.com"
        val userName = name?.trim() ?: "Alex Vance"
        val userAvatar = avatarUrl ?: "https://lh3.googleusercontent.com/a/default-user"

        val user = UserAccount(
            id = "usr_google_${userEmail.hashCode()}",
            name = userName,
            email = userEmail,
            emailVerified = true,
            avatarUrl = userAvatar,
            jobTitle = "Founder & CEO"
        )

        currentUser = user
        return Result.success(user)
    }

    override suspend fun logout(): Result<Unit> {
        currentUser = null
        secureStorage?.remove("auth_tokens")
        return Result.success(Unit)
    }

    override suspend fun getCurrentUser(): UserAccount? = currentUser

    override suspend fun updateProfile(name: String, jobTitle: String?): Result<UserAccount> {
        val current = currentUser ?: return Result.failure(AppException(AppError.Unauthorized))
        val updated = current.copy(name = name, jobTitle = jobTitle)
        currentUser = updated
        return Result.success(updated)
    }

    override suspend fun deleteAccount(): Result<Unit> {
        currentUser = null
        secureStorage?.remove("auth_tokens")
        return Result.success(Unit)
    }
}
</file>

<file path="app/src/commonTest/kotlin/com/revlens/app/domain/calc/CacCalculatorTest.kt">
package com.revlens.app.domain.calc

import com.revlens.app.domain.model.MarketingSpendRecord
import com.revlens.app.domain.model.SubscriptionRecord
import com.revlens.app.model.BigDecimal
import com.revlens.app.model.BusinessProfile
import com.revlens.app.model.Plan
import kotlin.test.Test
import kotlin.test.assertEquals
import kotlin.test.assertTrue

class CacCalculatorTest {

    @Test
    fun testCalculateModeled() {
        val profile = BusinessProfile(
            monthlyChurnRate = 2.0,
            monthlyGrowthRate = 10.0,
            cac = BigDecimal("150.00"),
            fixedCosts = BigDecimal("5000.00"),
            variableCostPerCustomer = BigDecimal("10.00"),
            plans = listOf(
                Plan(id = "1", name = "Starter", price = BigDecimal("50.00"), customerCount = 100)
            )
        )

        val result = CacCalculator.calculateModeled(profile)

        // totalCustomers = 100, monthlyGrowthRate = 10% -> 10 new customers
        assertEquals(10, result.totalNewCustomers)
        // base CAC = $150 = 15000 cents
        assertEquals(15000L, result.blendedCacMinor)
        assertEquals(4, result.channelBreakdown.size)
        assertEquals(3, result.funnelStages.size)
        assertTrue(result.paybackPeriodMonths > 0.0)
    }

    @Test
    fun testCalculateActual() {
        val spend = listOf(
            MarketingSpendRecord(
                month = "2024-01-01", channel = "Google Ads", spendMinor = 100000L,
                newCustomers = 10
            ),
            MarketingSpendRecord(
                month = "2024-01-01", channel = "Meta Ads", spendMinor = 50000L, newCustomers = 5
            )
        )
        val subs = listOf(
            SubscriptionRecord(
                customerId = "C1", plan = "Starter", startDate = "2024-01-01", mrrMinor = 5000L
            )
        )

        val result = CacCalculator.calculateActual(
            spendRecords = spend,
            subscriptions = subs,
            arpu = BigDecimal("50.00"),
            grossMarginPercent = 80.0
        )

        // Total spend = 150,000 cents = $1,500
        assertEquals(150000L, result.totalSpendMinor)
        // Total new customers from spend = 15
        assertEquals(15, result.totalNewCustomers)
        // Blended CAC = 150,000 / 15 = 10,000 cents = $100
        assertEquals(10000L, result.blendedCacMinor)
        assertEquals(2, result.channelBreakdown.size)
        // Payback period: CAC $100 / ($50 * 0.8 = $40) = 2.5 months
        assertEquals(2.5, result.paybackPeriodMonths)
    }
}
</file>

<file path="app/src/commonTest/kotlin/com/revlens/app/domain/calc/CohortCalculatorTest.kt">
package com.revlens.app.domain.calc

import com.revlens.app.domain.model.Dataset
import com.revlens.app.domain.model.SubscriptionRecord
import com.revlens.app.model.BigDecimal
import com.revlens.app.model.BusinessProfile
import com.revlens.app.model.Plan
import com.revlens.app.ui.components.display.DataSourceMode
import kotlin.test.Test
import kotlin.test.assertEquals
import kotlin.test.assertTrue

class CohortCalculatorTest {

    @Test
    fun testModeledRetentionCurve() {
        val profile = BusinessProfile(
            monthlyChurnRate = 5.0,
            monthlyGrowthRate = 10.0,
            cac = BigDecimal("100.00"),
            fixedCosts = BigDecimal("1000.00"),
            variableCostPerCustomer = BigDecimal("5.00"),
            plans = listOf(
                Plan(id = "1", name = "Default", price = BigDecimal("50.00"), customerCount = 100)
            )
        )

        val result = CohortCalculator.build(
            profile = profile,
            dataset = null,
            maxOffsets = 6
        )

        assertEquals(DataSourceMode.MODELED, result.sourceMode)
        assertTrue(result.rows.isEmpty())
        assertEquals(6, result.averageCurve.size)
        // M0 is 100%
        assertEquals(100.0, result.averageCurve[0])
        // M1 is 95% (1 - 0.05)
        assertEquals(95.0, result.averageCurve[1])
        // Monotonically decreasing
        assertTrue(result.averageCurve[2] < result.averageCurve[1])
        assertTrue(result.bestCohortInsight.contains("Modeled Month-3 retention"))
    }

    @Test
    fun testActualLogoRetentionMatrix() {
        val subscriptions = listOf(
            // Jan 2026 cohort (3 customers)
            SubscriptionRecord("c1", "Pro", "2026-01-01", null, 10000L),
            SubscriptionRecord("c2", "Pro", "2026-01-10", "2026-02-15", 10000L), // churned at M1
            SubscriptionRecord("c3", "Starter", "2026-01-15", null, 5000L),
            // Feb 2026 cohort (2 customers)
            SubscriptionRecord("c4", "Pro", "2026-02-01", null, 10000L),
            SubscriptionRecord("c5", "Starter", "2026-02-10", null, 5000L)
        )

        val dataset = Dataset(
            id = "ds_cohort",
            workspaceId = "ws_cohort",
            filename = "subs.csv",
            subscriptions = subscriptions
        )

        val result = CohortCalculator.build(
            profile = null,
            dataset = dataset,
            metric = CohortMetric.LOGO_RETENTION,
            maxOffsets = 4
        )

        assertEquals(DataSourceMode.ACTUAL, result.sourceMode)
        assertEquals(2, result.rows.size)

        val janCohort = result.rows[0]
        assertEquals("Jan '26", janCohort.cohortLabel)
        assertEquals(3, janCohort.initialSize)
        assertEquals(100.0, janCohort.cells[0].retentionPercent)

        val febCohort = result.rows[1]
        assertEquals("Feb '26", febCohort.cohortLabel)
        assertEquals(2, febCohort.initialSize)

        // For Feb cohort, M2 and M3 are younger (beyond available months)
        assertTrue(febCohort.cells[1].isYounger || febCohort.cells[2].isYounger)
    }
}
</file>

