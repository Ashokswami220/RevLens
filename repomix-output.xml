                                    fontWeight = FontWeight.SemiBold,
                                    color = RevLensTheme.colors.textPrimary
                                )
                                Text(
                                    text = section.description,
                                    style = RevLensTypography.labelSmall,
                                    color = RevLensTheme.colors.textSecondary
                                )
