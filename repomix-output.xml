                                text = "Cancel",
                                onClick = {
                                    viewModel.onEvent(
                                        BillingEvent.PromptCancelSubscription
                                    )
                                },
                                modifier = Modifier.weight(0.6f)
                            )
                        }
                    }
                }
            }

            // ENTITLEMENTS & USAGE METERS
            Column(
                modifier = Modifier.fillMaxWidth(),
                verticalArrangement = Arrangement.spacedBy(12.dp)
            ) {
                Text(
                    text = "Resource Usage & Limits",
