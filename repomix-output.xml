            ) {
                Column {
                    Text(
                        text = "Blended Customer Acquisition Cost",
                        style = RevLensTypography.labelMedium,
                        color = RevLensTheme.colors.textSecondary
                    )
                    Text(
                        text = "$currencySymbol${result.blendedCacMinor / 100}",
                        style = RevLensTypography.displayLarge,
