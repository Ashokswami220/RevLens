@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun GoalPlannerScreen(
    viewModel: MainViewModel = koinViewModel(),
    onNavigateBack: () -> Unit
) {
    val profile by viewModel.profile.collectAsState()

    val currentMrr = profile?.currentMrr?.toFloat() ?: 1000f
    val initialGoal = profile?.mrrGoal?.toFloat() ?: (currentMrr * 2)
    var targetMrr by rememberSaveable {
        mutableStateOf(
            initialGoal.coerceIn(currentMrr, maxOf(currentMrr * 10, currentMrr + 1000f))
        )
    }
    var targetMonths by rememberSaveable { mutableStateOf(12f) }

    LaunchedEffect(profile) {
        val base = profile?.currentMrr?.toFloat() ?: 1000f
        val goal = profile?.mrrGoal?.toFloat() ?: (base * 2)
        targetMrr = goal.coerceIn(base, maxOf(base * 10, base + 1000f))
    }

    val goalPlan = remember(profile, targetMrr, targetMonths) {
        profile?.let {
            MrrGoalPlanner.calculateRequiredMetrics(
                currentProfile = it,
                targetMrr = BigDecimal(targetMrr.toString()),
                months = targetMonths.roundToInt()
            )
        }
    }

    val currencyFormatter = remember(profile?.currencyCode) {
        CurrencyUtils.getFormatter(profile?.currencyCode)
    }

    Scaffold(
        topBar = {
            RevLensTopAppBar(title = "MRR Goal Planner", onBackClick = onNavigateBack)
        },
        containerColor = RevLensTheme.colors.background
    ) { paddingValues ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(paddingValues)
                .verticalScroll(rememberScrollState())
                .padding(16.dp),
            verticalArrangement = Arrangement.spacedBy(16.dp)
        ) {

            SectionCard(title = "Set Your Goal") {
                Column(verticalArrangement = Arrangement.spacedBy(16.dp)) {
                    val safeMax = maxOf(currentMrr * 10, currentMrr + 1000f)
                    LabeledSlider(
                        label = "Target MRR",
                        value = targetMrr.coerceIn(currentMrr, safeMax),
                        onValueChange = { targetMrr = it },
                        valueRange = currentMrr..safeMax,
                        valueString = currencyFormatter.format(targetMrr),
                        caption = "Your revenue goal"
                    )

                    LabeledSlider(
                        label = "Timeframe",
                        value = targetMonths,
                        onValueChange = { targetMonths = it },
                        valueRange = 1f..60f,
                        valueString = "${targetMonths.toInt()} months",
                        caption = "Months to achieve this goal"
                    )
                }
            }

            if (goalPlan != null) {
                SectionCard(title = "What It Takes") {
                    Column(verticalArrangement = Arrangement.spacedBy(12.dp)) {
                        ResultRow(
                            label = "Required Monthly Growth (CMGR)",
                            value = "${
                                CurrencyUtils.formatDecimal(
                                    goalPlan.requiredMonthlyGrowthRate * 100, 1
                                )
                            }%"
                        )

                        ResultRow(
                            label = "New Customers Needed / Month",
                            value = "${goalPlan.requiredNewCustomersPerMonth}",
                            caption = "(Assuming ARPU stays the same)"
                        )

                        ResultRow(
                            label = "Or, Required ARPU",
                            value = currencyFormatter.format(goalPlan.requiredArpu),
                            caption = "(Assuming Customer count stays the same)"
                        )
                    }
                }
            }

            PrimaryButton(
                text = "Save Goal",
                onClick = {
                    val currentProfile = profile
                    if (currentProfile != null) {
                        viewModel.updateProfile(
                            currentProfile.copy(mrrGoal = BigDecimal(targetMrr.toString()))
                        )
                        onNavigateBack()
                    }
                },
                modifier = Modifier.fillMaxWidth()
            )
        }
    }
}

@Composable
private fun ResultRow(label: String, value: String, caption: String? = null) {
    Column {
        Text(
            text = label, style = RevLensTypography.bodyMedium,
            color = RevLensTheme.colors.textSecondary
        )
        Text(
            text = value, style = RevLensTypography.headlineMedium, fontWeight = FontWeight.Bold,
            color = RevLensTheme.colors.brandPrimary
        )
        if (caption != null) {
            Text(
                text = caption, style = RevLensTypography.labelSmall,
                color = RevLensTheme.colors.textTertiary
            )
        }
    }
}
