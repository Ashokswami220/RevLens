<file path="app/src/commonMain/kotlin/com/revlens/app/core/ui/AppError.kt">
package com.revlens.app.core.ui

sealed interface AppError {
    data object Network : AppError
    data object Unauthorized : AppError
    data object InvalidCredentials : AppError
    data object Forbidden : AppError
    data object NotFound : AppError
    data class Conflict(val message: String? = null) : AppError
    data class Validation(val fields: Map<String, String>) : AppError
    data class RateLimited(val retryAfterSeconds: Int? = null) : AppError
    data class PlanLimit(val feature: String) : AppError
    data object Server : AppError
    data class Unknown(val cause: Throwable? = null) : AppError
}

fun AppError.toUiText(): UiText = when (this) {
    AppError.Network -> UiText.DynamicString(
        "Network error. Please check your connection and retry."
    )

    AppError.Unauthorized -> UiText.DynamicString("Your session has expired. Please sign in again.")
    AppError.InvalidCredentials -> UiText.DynamicString("Invalid email or password.")
    AppError.Forbidden -> UiText.DynamicString("You do not have permission to perform this action.")
    AppError.NotFound -> UiText.DynamicString("Requested resource was not found.")
    is AppError.Conflict -> UiText.DynamicString(
        message ?: "A conflicting resource already exists."
    )

    is AppError.Validation -> UiText.DynamicString(
        fields.values.firstOrNull() ?: "Please check input fields."
    )

    is AppError.RateLimited -> UiText.DynamicString(
        if (retryAfterSeconds != null) "Too many attempts. Try again in $retryAfterSeconds seconds."
        else "Too many attempts. Please try again later."
    )

    is AppError.PlanLimit -> UiText.DynamicString("Upgrade your plan to unlock $feature.")
    AppError.Server -> UiText.DynamicString("Server error. Please try again shortly.")
    is AppError.Unknown -> UiText.DynamicString(cause?.message ?: "An unexpected error occurred.")
}

class AppException(val error: AppError) : Exception(
    error.toUiText()
        .asString()
)

fun Throwable.toAppError(): AppError = when (this) {
    is AppException -> this.error
    else -> AppError.Unknown(this)
}

fun Throwable.toUiText(): UiText = toAppError().toUiText()
</file>

<file path="app/src/commonMain/kotlin/com/revlens/app/data/DefaultWorkspaceRepository.kt">
package com.revlens.app.data

import com.revlens.app.domain.model.Workspace
import com.revlens.app.domain.repository.WorkspaceRepository
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.asStateFlow

class DefaultWorkspaceRepository(
    initialWorkspaces: List<Workspace> = emptyList()
) : WorkspaceRepository {
    private val _workspaces = MutableStateFlow(initialWorkspaces)
    override val workspacesFlow: Flow<List<Workspace>> = _workspaces.asStateFlow()

    override suspend fun getWorkspace(id: String): Workspace? {
        return _workspaces.value.firstOrNull { it.id == id }
    }

    override suspend fun createWorkspace(workspace: Workspace) {
        val current = _workspaces.value.toMutableList()
        val index = current.indexOfFirst { it.id == workspace.id }
        if (index != -1) {
            current[index] = workspace
        } else {
            current.add(workspace)
        }
        _workspaces.value = current
    }

    override suspend fun updateWorkspace(workspace: Workspace) {
        createWorkspace(workspace)
    }

    override suspend fun deleteWorkspace(id: String) {
        _workspaces.value = _workspaces.value.filter { it.id != id }
    }

    override suspend fun clearLocalData() {
        _workspaces.value = emptyList()
    }
}
</file>

<file path="app/src/commonMain/kotlin/com/revlens/app/domain/calc/CacCalculator.kt">
package com.revlens.app.domain.calc

import com.revlens.app.domain.model.MarketingSpendRecord
import com.revlens.app.domain.model.SubscriptionRecord
import com.revlens.app.model.BigDecimal
import com.revlens.app.model.BusinessProfile

data class ChannelEfficiency(
    val channel: String,
    val totalSpendMinor: Long,
    val newCustomers: Int,
    val cacMinor: Long,
    val sharePercent: Double,
    val efficiencyRating: String // "Top Tier", "Strong", "Underperforming"
)

data class FunnelStage(
    val stageName: String,
    val count: Int,
    val conversionRateFromPrevious: Double = 100.0,
    val overallConversionRate: Double = 100.0
)

data class CacAnalysisResult(
    val blendedCacMinor: Long,
    val totalSpendMinor: Long,
    val totalNewCustomers: Int,
    val paybackPeriodMonths: Double,
    val channelBreakdown: List<ChannelEfficiency>,
    val funnelStages: List<FunnelStage>
)

object CacCalculator {

    fun calculateModeled(
        profile: BusinessProfile,
        simulatedBudgetMinor: Long? = null
    ): CacAnalysisResult {
        val baseCacMinor = (profile.cac.toDouble() * 100).toLong()
            .coerceAtLeast(100L)
        val defaultMonthlyNewCustomers =
            (profile.totalCustomers * (profile.monthlyGrowthRate / 100.0)).toInt()
                .coerceAtLeast(1)
        val defaultSpendMinor = simulatedBudgetMinor ?: (defaultMonthlyNewCustomers * baseCacMinor)

        val totalCustomers = defaultMonthlyNewCustomers
        val blendedCac =
            if (totalCustomers > 0) defaultSpendMinor / totalCustomers else baseCacMinor

        val arpuMinor = (profile.arpu.toDouble() * 100).toLong()
            .coerceAtLeast(100L)
        val varCostMinor = (profile.variableCostPerCustomer.toDouble() * 100).toLong()
        val marginFraction = if (arpuMinor > 0) {
            ((arpuMinor - varCostMinor).toDouble() / arpuMinor.toDouble()).coerceIn(0.1, 1.0)
        } else 0.8
        val monthlyMarginMinor = (arpuMinor * marginFraction).toLong()
            .coerceAtLeast(10L)
        val paybackMonths = if (monthlyMarginMinor > 0) {
            blendedCac.toDouble() / monthlyMarginMinor.toDouble()
        } else 0.0

        // Simulated distribution across standard acquisition channels
        val channels = listOf(
            Triple("Direct / Organic", 0.35, 0.40),
            Triple("Google Search Ads", 0.30, 0.25),
            Triple("Meta / Instagram", 0.25, 0.20),
            Triple("Referral & Viral", 0.10, 0.15)
        )

        val channelBreakdown = channels.map { (name, spendShare, custShare) ->
            val spend = (defaultSpendMinor * spendShare).toLong()
            val custs = (totalCustomers * custShare).toInt()
                .coerceAtLeast(1)
            val cac = if (custs > 0) spend / custs else 0L
            val rating = when {
                cac <= (blendedCac * 0.75) -> "Top Tier"
                cac <= (blendedCac * 1.25) -> "Strong"
                else -> "Underperforming"
            }
            ChannelEfficiency(
                channel = name,
                totalSpendMinor = spend,
                newCustomers = custs,
                cacMinor = cac,
                sharePercent = spendShare * 100.0,
                efficiencyRating = rating
            )
        }

        // Standard SaaS acquisition funnel benchmark (e.g. 10,000 visitors -> 600 trials (6%) -> 150 paid (25%))
        val paidCount = totalCustomers
        val trialCount = (paidCount * 4.5).toInt()
            .coerceAtLeast(paidCount)
        val visitorCount = (trialCount * 14.0).toInt()
            .coerceAtLeast(trialCount)

        val funnelStages = listOf(
            FunnelStage(
                stageName = "Website Visitors",
                count = visitorCount,
                conversionRateFromPrevious = 100.0,
                overallConversionRate = 100.0
            ),
            FunnelStage(
                stageName = "Signups & Trials",
                count = trialCount,
                conversionRateFromPrevious = if (visitorCount > 0) (trialCount.toDouble() / visitorCount.toDouble()) * 100 else 0.0,
                overallConversionRate = if (visitorCount > 0) (trialCount.toDouble() / visitorCount.toDouble()) * 100 else 0.0
            ),
            FunnelStage(
                stageName = "Paid Customers",
                count = paidCount,
                conversionRateFromPrevious = if (trialCount > 0) (paidCount.toDouble() / trialCount.toDouble()) * 100 else 0.0,
                overallConversionRate = if (visitorCount > 0) (paidCount.toDouble() / visitorCount.toDouble()) * 100 else 0.0
            )
        )

        return CacAnalysisResult(
            blendedCacMinor = blendedCac,
            totalSpendMinor = defaultSpendMinor,
            totalNewCustomers = totalCustomers,
            paybackPeriodMonths = (paybackMonths * 10).toInt() / 10.0,
            channelBreakdown = channelBreakdown,
            funnelStages = funnelStages
        )
    }

    fun calculateActual(
        spendRecords: List<MarketingSpendRecord>,
        subscriptions: List<SubscriptionRecord>,
        arpu: BigDecimal,
        grossMarginPercent: Double
    ): CacAnalysisResult {
        if (spendRecords.isEmpty() && subscriptions.isEmpty()) {
            return CacAnalysisResult(
                blendedCacMinor = 0L,
                totalSpendMinor = 0L,
                totalNewCustomers = 0,
                paybackPeriodMonths = 0.0,
                channelBreakdown = emptyList(),
                funnelStages = emptyList()
            )
        }

        val totalSpend = spendRecords.sumOf { it.spendMinor }
        val groupedSpend = spendRecords.groupBy { it.channel.ifBlank { "Direct" } }
        val newFromSpend = spendRecords.sumOf { it.newCustomers ?: 0 }
        val newFromSubs = subscriptions.count { it.endDate == null }
        val totalNew = if (newFromSpend > 0) newFromSpend else newFromSubs.coerceAtLeast(1)

        val blendedCac = if (totalNew > 0) totalSpend / totalNew else totalSpend

        val monthlyMargin = arpu.toDouble() * (grossMarginPercent / 100.0)
        val paybackMonths = if (monthlyMargin > 0) (blendedCac / 100.0) / monthlyMargin else 0.0

        val channelList = mutableListOf<ChannelEfficiency>()
        groupedSpend.forEach { (channel, records) ->
            val spend = records.sumOf { it.spendMinor }
            val custs = records.sumOf { it.newCustomers ?: 0 }
                .coerceAtLeast(1)
            val cac = spend / custs
            val share =
                if (totalSpend > 0) (spend.toDouble() / totalSpend.toDouble()) * 100.0 else 0.0
            val rating = when {
                cac <= (blendedCac * 0.75) -> "Top Tier"
                cac <= (blendedCac * 1.25) -> "Strong"
                else -> "Underperforming"
            }
            channelList.add(
                ChannelEfficiency(
                    channel = channel,
                    totalSpendMinor = spend,
                    newCustomers = custs,
                    cacMinor = cac,
                    sharePercent = share,
                    efficiencyRating = rating
                )
            )
        }

        // Funnel estimation
        val paidCount = totalNew
        val trialCount = (paidCount * 4).coerceAtLeast(paidCount)
        val visitorCount = (trialCount * 12).coerceAtLeast(trialCount)

        val funnelStages = listOf(
            FunnelStage("Website Visitors", visitorCount, 100.0, 100.0),
            FunnelStage(
                "Signups & Trials",
                trialCount,
                if (visitorCount > 0) (trialCount.toDouble() / visitorCount.toDouble()) * 100 else 0.0,
                if (visitorCount > 0) (trialCount.toDouble() / visitorCount.toDouble()) * 100 else 0.0
            ),
            FunnelStage(
                "Paid Customers",
                paidCount,
                if (trialCount > 0) (paidCount.toDouble() / trialCount.toDouble()) * 100 else 0.0,
                if (visitorCount > 0) (paidCount.toDouble() / visitorCount.toDouble()) * 100 else 0.0
            )
        )

        return CacAnalysisResult(
            blendedCacMinor = blendedCac,
            totalSpendMinor = totalSpend,
            totalNewCustomers = totalNew,
            paybackPeriodMonths = (paybackMonths * 10).toInt() / 10.0,
            channelBreakdown = channelList.sortedByDescending { it.totalSpendMinor },
            funnelStages = funnelStages
        )
    }
}
