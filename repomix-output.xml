                if (code === 'auth/operation-not-allowed') {
                    window.revlensFirebase.lastAuthError = 'Google provider is not enabled in Firebase Console. Please enable Google under Authentication > Sign-in method.';
                } else if (code === 'auth/unauthorized-domain') {
                    window.revlensFirebase.lastAuthError = 'Domain not authorized in Firebase Console > Authentication > Settings > Authorized Domains.';
                } else {
                    window.revlensFirebase.lastAuthError = msg;
                }
                window.revlensFirebase.authStatus = 'error';
            });
