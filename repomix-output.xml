                        placeholder = "e.g. YouTube Ads, Affiliates, TikTok"
                    )
                    NumberField(
                        value = spendInput,
                        onValueChange = { spendInput = it },
                        label = "Monthly Budget (${state.currencySymbol})",
                        suffix = state.currencySymbol
