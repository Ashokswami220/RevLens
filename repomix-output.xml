    // Modal Bottom Sheet: Preview Report
    val preview = state.previewReport
    if (preview != null) {
        ModalBottomSheet(
            onDismissRequest = { viewModel.onEvent(ReportsEvent.DismissViewReport) },
            sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true),
