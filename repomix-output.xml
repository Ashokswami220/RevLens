                    avatarUrl: user.photoURL || null
                });
                window.revlensFirebase.authStatus = 'success';
            }).catch(err => {
                const code = err ? (err.code || '') : '';
                const msg = err ? (err.message || String(err)) : 'Google sign-in cancelled or failed';
                console.error('Firebase Auth Error:', code, msg);
                if (code === 'auth/popup-blocked') {
                    console.warn('Popup blocked, attempting signInWithRedirect fallback...');
                    firebase.auth().signInWithRedirect(provider).catch(redirErr => {
                        window.revlensFirebase.lastAuthError = redirErr ? redirErr.message : 'Redirect failed';
                        window.revlensFirebase.authStatus = 'error';
