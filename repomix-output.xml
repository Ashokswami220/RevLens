                    IconButton(onClick = { viewModel.onEvent(ReportsEvent.DismissViewReport) }) {
                        Icon(
                            imageVector = Icons.Filled.Close,
                            contentDescription = "Close",
                            tint = RevLensTheme.colors.textSecondary
                        )
