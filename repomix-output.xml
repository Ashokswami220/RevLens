            }

            val nextTitle = when (step) {
                0 -> "Select File"
                1 -> "Map Columns"
                2 -> "Review"
                3 -> "Commit Import"
                else -> "Next"
            }

            PrimaryButton(
                text = nextTitle,
                onClick = onNextClick,
                enabled = canProceed,
                isLoading = isLoading,
                modifier = Modifier.weight(if (step > 0) 2f else 1f)
            )
        }
    }
}
